# ============================================================
# 机械革命 无界15X 锐龙版 R7-8845HS — 核心内核配置
# ============================================================

##### 架构 / 基础 #####
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_GENERIC_CPU=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y

##### 电源 / CPU频率 #####
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_SUSPEND=y
CONFIG_ACPI=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_ACPI_CPPC_LIB=y
CONFIG_CPU_IDLE=y

##### AMD 平台 #####
CONFIG_MICROCODE=y
CONFIG_MICROCODE_AMD=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_AMD_IOMMU=y

##### 显卡 — Radeon 780M #####
CONFIG_DRM=y
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_AMD_DC_DCN=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FB_EFI=y

##### 音频 — Realtek + HDMI #####
CONFIG_SND=y
CONFIG_SND_HDA=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y

##### 无线 / 蓝牙 — MT7922 #####
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7921E=m
CONFIG_BT=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_RFKILL=y

##### 存储 — NVMe #####
CONFIG_BLK_DEV_NVME=y

##### USB / USB4 / Type-C #####
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_TYPEC=y
CONFIG_TYPEC_UCSI=y
CONFIG_UCSI_ACPI=y
CONFIG_USB4=y

##### 摄像头 #####
CONFIG_MEDIA_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=y

##### 传感器 #####
CONFIG_HWMON=y
CONFIG_SENSORS_K10TEMP=y